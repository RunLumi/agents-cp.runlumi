{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lumi-agents-control-plane-api",
  "main": "sentry-entry.mjs",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "vars": {
    "ENVIRONMENT": "production",
    "OUTBOX_DLQ_NAME": "lumi-agents-outbox-dlq",
    "JOBS_DLQ_NAME": "lumi-agents-jobs-dlq",
    // The job handler routes on this name, so it has to be the queue this
    // environment actually binds. It was declared nowhere, and the code's
    // fallback to "lumi-agents-jobs" matched production by luck while
    // silently mismatching development -- where every P06 job message was
    // handed to the P01 outbox consumer, decoded as a business event, rejected,
    // and acknowledged. See VFY-009.
    "JOBS_QUEUE_NAME": "lumi-agents-jobs",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumi-agents-control-plane",
      "migrations_dir": "./migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "EXPORT_ARTIFACTS",
      "bucket_name": "lumi-agents-control-plane-exports",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "OUTBOX_QUEUE",
        "queue": "lumi-agents-outbox",
      },
      {
        "binding": "JOBS_QUEUE",
        "queue": "lumi-agents-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "lumi-agents-outbox",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 6,
        "dead_letter_queue": "lumi-agents-outbox-dlq",
        "retry_delay": 30,
      },
      {
        "queue": "lumi-agents-outbox-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "retry_delay": 60,
      },
      {
        "queue": "lumi-agents-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 8,
        "dead_letter_queue": "lumi-agents-jobs-dlq",
        "retry_delay": 30,
      },
      {
        "queue": "lumi-agents-jobs-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "retry_delay": 60,
      },
    ],
  },
  "triggers": {
    "crons": ["*/1 * * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "build": {
    "command": "worker-build --release",
  },
  "env": {
    "production": {
      "send_email": [{ "name": "EMAIL" }],
    },
    "development": {
      "name": "lumi-agents-control-plane-api-development",
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "vars": {
        "ENVIRONMENT": "development",
        "OUTBOX_DLQ_NAME": "lumi-agents-outbox-development-dlq",
        "JOBS_DLQ_NAME": "lumi-agents-jobs-development-dlq",
        "JOBS_QUEUE_NAME": "lumi-agents-jobs-development",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lumi-agents-control-plane-development",
          "migrations_dir": "./migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "EXPORT_ARTIFACTS",
          "bucket_name": "lumi-agents-control-plane-exports-development",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "OUTBOX_QUEUE",
            "queue": "lumi-agents-outbox-development",
          },
          {
            "binding": "JOBS_QUEUE",
            "queue": "lumi-agents-jobs-development",
          },
        ],
        "consumers": [
          {
            "queue": "lumi-agents-outbox-development",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 6,
            "dead_letter_queue": "lumi-agents-outbox-development-dlq",
            "retry_delay": 30,
          },
          {
            "queue": "lumi-agents-outbox-development-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 10,
            "retry_delay": 60,
          },
          {
            "queue": "lumi-agents-jobs-development",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 8,
            "dead_letter_queue": "lumi-agents-jobs-development-dlq",
            "retry_delay": 30,
          },
          {
            "queue": "lumi-agents-jobs-development-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 10,
            "retry_delay": 60,
          },
        ],
      },
      "triggers": {
        "crons": ["*/1 * * * *"],
      },
    },
    "production": {
      "name": "lumi-agents-control-plane-api-production",
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "vars": {
        "ENVIRONMENT": "production",
        "OUTBOX_DLQ_NAME": "lumi-agents-outbox-dlq",
        "JOBS_DLQ_NAME": "lumi-agents-jobs-dlq",
        "JOBS_QUEUE_NAME": "lumi-agents-jobs",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lumi-agents-control-plane",
          "migrations_dir": "./migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "EXPORT_ARTIFACTS",
          "bucket_name": "lumi-agents-control-plane-exports",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "OUTBOX_QUEUE",
            "queue": "lumi-agents-outbox",
          },
          {
            "binding": "JOBS_QUEUE",
            "queue": "lumi-agents-jobs",
          },
        ],
        "consumers": [
          {
            "queue": "lumi-agents-outbox",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 6,
            "dead_letter_queue": "lumi-agents-outbox-dlq",
            "retry_delay": 30,
          },
          {
            "queue": "lumi-agents-outbox-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 10,
            "retry_delay": 60,
          },
          {
            "queue": "lumi-agents-jobs",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 8,
            "dead_letter_queue": "lumi-agents-jobs-dlq",
            "retry_delay": 30,
          },
          {
            "queue": "lumi-agents-jobs-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 10,
            "retry_delay": 60,
          },
        ],
      },
      "triggers": {
        "crons": ["*/1 * * * *"],
      },
    },
  },
}
