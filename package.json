{
  "name": "lumi-agents-control-plane",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "pnpm -r --parallel --stream --filter @runlumi/agents-cp-api --filter @runlumi/agents-cp-web dev",
    "build": "pnpm -r --filter @runlumi/agents-cp-api --filter @runlumi/agents-cp-web build",
    "db:migrate:local": "pnpm --filter @runlumi/agents-cp-api db:migrations:apply:local",
    "db:migrations:list:local": "pnpm --filter @runlumi/agents-cp-api db:migrations:list:local",
    "smoke:local": "pnpm --filter @runlumi/agents-cp-api smoke:local",
    "smoke:p02": "pnpm --filter @runlumi/agents-cp-api smoke:p02",
    "smoke:passkey": "pnpm --filter @runlumi/agents-cp-api smoke:passkey",
    "smoke:browser": "pnpm --filter @runlumi/agents-cp-web smoke:browser",
    "guard:probe": "pnpm --filter @runlumi/agents-cp-api guard:probe",
    "smoke:p04": "pnpm --filter @runlumi/agents-cp-api smoke:p04",
    "smoke:p03": "pnpm --filter @runlumi/agents-cp-api smoke:p03",
    "smoke:p05": "pnpm --filter @runlumi/agents-cp-api smoke:p05",
    "smoke:p06": "node apps/api/scripts/p06-data-smoke.mjs",
    "smoke:p08": "node apps/api/scripts/p08-tenancy-smoke.mjs",
    "verify:adoption-privacy": "pnpm --filter @runlumi/agents-cp-api verify:adoption-privacy",
    "verify:privilege-escalation": "pnpm --filter @runlumi/agents-cp-api verify:privilege-escalation",
    "verify:budget-concurrency": "pnpm --filter @runlumi/agents-cp-api verify:budget-concurrency",
    "verify:migration-prior-state": "bash docs/verification/runs/2026-09-31-v01-adversarial-security-state/evidence/v01-007-migration-prior-state.sh",
    "verify:mutating-tenancy": "node apps/api/scripts/v01-mutating-tenancy-probe.mjs",
    "verify:collection-tenancy": "pnpm --filter @runlumi/agents-cp-api verify:collection-tenancy",
    "verify:idempotency": "node apps/api/scripts/v01-idempotency-probe.mjs",
    "verify:filter-tenancy": "node apps/api/scripts/v01-filter-tenancy-probe.mjs",
    "verify:inference-failure": "node apps/api/scripts/v01-inference-failure-probe.mjs",
    "verify:provider-faults": "node apps/api/scripts/v01-provider-fault-probe.mjs",
    "verify:lease-contention": "node apps/api/scripts/v01-lease-contention-probe.mjs",
    "verify:attempt-exhaustion": "node apps/api/scripts/v01-attempt-exhaustion-probe.mjs",
    "verify:device-idempotency": "node apps/api/scripts/v01-device-idempotency-probe.mjs",
    "verify:revoked-device": "node apps/api/scripts/v01-revoked-device-probe.mjs",
    "verify:invitation-race": "node apps/api/scripts/v01-invitation-race-probe.mjs",
    "verify:usage-attribution": "node apps/api/scripts/v01-usage-attribution-probe.mjs",
    "format": "oxfmt apps/web/src apps/web/scripts apps/web/vite.config.ts apps/web/index.html apps/web/package.json apps/web/components.json apps/web/tsconfig.json apps/api/package.json apps/api/scripts apps/api/wrangler.jsonc package.json pnpm-workspace.yaml .github/workflows/checks.yml && cargo fmt --all",
    "format:check": "oxfmt --check apps/web/src apps/web/scripts apps/web/vite.config.ts apps/web/index.html apps/web/package.json apps/web/components.json apps/web/tsconfig.json apps/api/package.json apps/api/scripts apps/api/wrangler.jsonc package.json pnpm-workspace.yaml .github/workflows/checks.yml && cargo fmt --all -- --check",
    "lint": "oxlint --type-aware apps/web/src apps/web/vite.config.ts",
    "typecheck": "pnpm --filter @runlumi/agents-cp-web typecheck",
    "test": "pnpm --filter @runlumi/agents-cp-web test && cargo test --workspace && pnpm schema:p07 && pnpm canary:p09 && pnpm test:sentry-bridge && pnpm schema:null-check && pnpm guard:probe && pnpm verify:campaign-selftest && pnpm schema:bind-count",
    "schema:p07": "node apps/api/scripts/p07-schema-invariants.mjs",
    "canary:p09": "node apps/api/scripts/p09-secret-canary.mjs",
    "rust:check": "cargo clippy --workspace --all-targets -- -D warnings && cargo check --workspace --target wasm32-unknown-unknown",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm rust:check",
    "ui:add": "pnpm --filter @runlumi/agents-cp-web ui:add",
    "schema:null-check": "node apps/api/scripts/p09-null-check-scan.mjs",
    "verify:mutation": "node apps/api/scripts/p09-mutation-campaign.mjs",
    "verify:restore": "node apps/api/scripts/p09-restore-rehearsal.mjs",
    "verify:campaign-selftest": "node apps/api/scripts/p09-mutation-campaign.mjs --self-test",
    "verify:campaign-preflight": "node apps/api/scripts/p09-mutation-campaign.mjs --preflight",
    "schema:bind-count": "node apps/api/scripts/p09-bind-count-scan.mjs",
    "test:sentry-bridge": "node --test apps/api/scripts/sentry-report-filter.test.mjs"
  },
  "devDependencies": {
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.5.1"
}
